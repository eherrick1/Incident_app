# --- Auth (reviewer side) ---
ADMIN_TOKEN=change-me
FLASK_SECRET=change-me-long-random

# --- AI extraction (provider-switchable) ---
# AI_PROVIDER: anthropic | gemini. Set the matching key. AI_MODEL is optional
# (defaults: claude-sonnet-4-5 / gemini-2.5-flash).
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Email (same process as the capital/expense apps) ---
# Office365: smtp.office365.com:587 (STARTTLS). Gmail: smtp.gmail.com:587 with
# an App Password. EMAIL_USERNAME optional (defaults to EMAIL_SENDER).
APPROVER_EMAIL=edwardherrick@gmail.com
APPROVER_NAME=Edward Herrick
EMAIL_SENDER=
# EMAIL_USERNAME=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
# SMTP_USE_SSL=false       # set true (port 465) for implicit TLS
# SMTP_STARTTLS=true
# MAIL_CC=                 # optional extra recipients, comma-separated

# --- URLs ---
BASE_URL=http://localhost:8080

# --- Durable storage (leave unset for local dev: SQLite + ./storage) ---
GCS_BUCKET=incidents-capital-processor
FIRESTORE_COLLECTION=incident_reports

# --- Carrier (auto-send OFF by default; reviewer se